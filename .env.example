# Copy to .env. Never commit real keys or exchange credentials.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_PROVIDER=openai-compatible

# Default-safe settings. Auto-accept applies only to constrained local text edits,
# never shell commands, network calls, credentials, or live trades.
AUTO_ACCEPT_EDITS=false
TRADING_MODE=paper
BITUNIX_BASE_URL=https://fapi.bitunix.com
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=
# Leave blank for read-only checks. Do not enable until you intentionally arm a live writer.
# Exact opt-in phrase is required by NewLiveClient; this does not enable autotrading by itself.
BITUNIX_LIVE_TRADING=
